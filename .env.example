# Only documents the variable added for the /blog feature. This repo has
# other environment variables already configured (Supabase, email, etc.)
# that aren't listed here.

# URL of the deployed outrank-webhook-service (see that directory's own
# README for deploy instructions). /blog reads articles from
# <this>/api/articles and <this>/api/articles/:slug. Leave unset and the
# blog pages render an empty "coming soon" state instead of erroring.
VITE_OUTRANK_API_URL=
OUTRANK_API_URL=
