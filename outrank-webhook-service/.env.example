# Copy this file to .env and fill in real values. Never commit .env.

# Required. The token Outrank must send on every webhook request.
# Generate a long random value (e.g. `openssl rand -hex 32`) and configure
# the SAME value in Outrank's webhook settings.
OUTRANK_ACCESS_TOKEN=

# Required. Same Supabase project as the main athera-intelligence site
# (see supabase/config.toml at the repo root). Get these from the Supabase
# dashboard: Project Settings -> API.
#   SUPABASE_URL             = the "Project URL"
#   SUPABASE_SERVICE_ROLE_KEY = the "service_role" secret key (NOT the
#                               anon/publishable key — this one bypasses RLS,
#                               never expose it to a browser)
# Run supabase/migrations/20260731100000_create_articles.sql once (SQL
# Editor in the dashboard, or `supabase db push`) before using this.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Port for the standalone server (ignored on Netlify Functions).
PORT=3001

# Optional. Comma-separated list of origins allowed to call GET /api/articles
# from a browser, e.g. https://athera-intelligence.com,https://www.athera-intelligence.com
# Leave unset to allow any origin (fine for a public read-only API).
ALLOWED_ORIGINS=
