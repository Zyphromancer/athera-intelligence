# Copy this file to .env and fill in real values. Never commit .env.

# Required. The token Outrank must send on every webhook request.
# Generate a long random value (e.g. `openssl rand -hex 32`) and configure
# the SAME value in Outrank's webhook settings.
OUTRANK_ACCESS_TOKEN=

# Port for the standalone server (ignored on Netlify Functions).
PORT=3001

# Optional. Comma-separated list of origins allowed to call GET /api/articles
# from a browser, e.g. https://athera-intelligence.com,https://www.athera-intelligence.com
# Leave unset to allow any origin (fine for a public read-only API).
ALLOWED_ORIGINS=
